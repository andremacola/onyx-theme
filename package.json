{
	"name": "onyx",
	"version": "0.4.0",
	"description": "Onyx Wordpress Starter Theme",
	"type": "module",
	"scripts": {
		"serve": "gulp serve",
		"dev": "gulp serve",
		"serve:prod": "env NODE_ENV=prod gulp serve",
		"build": "env NODE_ENV=prod gulp",
		"svg-spreact": "svg-spreact -t false -o true ./assets/images/svgs > ./assets/images/sprites.svg"
	},
	"author": "Andre Machado",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git@github.com:andremacola/onyx-theme.git"
	},
	"devDependencies": {
		"@rollup/plugin-commonjs": "^28.0.9",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^0.4.4",
		"@rollup/stream": "^3.0.1",
		"@wordpress/eslint-plugin": "^20.3.0",
		"dotenv": "^16.6.1",
		"eslint": "^8.57.1",
		"gulp": "^5.0.1",
		"gulp-autoprefixer": "^9.0.0",
		"gulp-if": "^3.0.0",
		"gulp-livereload": "github:andremacola/gulp-livereload",
		"gulp-purgecss": "^7.0.2",
		"gulp-rename": "^2.1.0",
		"gulp-sass": "^6.0.1",
		"rollup": "^4.60.2",
		"sass": "^1.99.0",
		"vinyl-source-stream": "^2.0.0"
	},
	"browserslist": [
		">0.2%",
		"last 2 versions",
		"Firefox ESR",
		"not dead"
